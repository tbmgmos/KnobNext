<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@android:style/TextAppearance.Material.Headline" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@android:style/TextAppearance.Material.Subhead"
            android:textStyle="bold" />

        <Button
            android:id="@+id/open_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_accessibility" />

        <LinearLayout
            android:id="@+id/restricted_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/restricted_hint"
                android:textAppearance="@android:style/TextAppearance.Material.Body1" />

            <Button
                android:id="@+id/open_app_info"
                style="@android:style/Widget.Material.Button.Borderless.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open_app_info" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/how_to_title"
            android:textAppearance="@android:style/TextAppearance.Material.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/how_to"
            android:textAppearance="@android:style/TextAppearance.Material.Body1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_title"
            android:textAppearance="@android:style/TextAppearance.Material.Title" />

        <Switch
            android:id="@+id/pref_enabled"
            style="@style/PrefSwitch"
            android:text="@string/pref_enabled" />

        <Switch
            android:id="@+id/pref_only_when_playing"
            style="@style/PrefSwitch"
            android:text="@string/pref_only_when_playing" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_only_when_playing_hint"
            android:textAppearance="@android:style/TextAppearance.Material.Caption" />

        <Switch
            android:id="@+id/pref_swap"
            style="@style/PrefSwitch"
            android:text="@string/pref_swap" />

        <Switch
            android:id="@+id/pref_combo"
            style="@style/PrefSwitch"
            android:text="@string/pref_combo" />

        <Switch
            android:id="@+id/pref_vibrate"
            style="@style/PrefSwitch"
            android:text="@string/pref_vibrate" />

        <TextView
            android:id="@+id/long_press_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="@android:style/TextAppearance.Material.Body1" />

        <SeekBar
            android:id="@+id/long_press_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
