<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">KnobNext</string>
    <string name="tagline">Треки кнопками громкости</string>
    <string name="service_label">KnobNext — треки кнопками громкости</string>
    <string name="service_description">Удержание кнопок громкости переключает трек или видео в любом плеере. Короткое нажатие меняет громкость как обычно. Сервис читает только нажатия кнопок громкости и не видит содержимое экрана.</string>
    <string name="listener_label">KnobNext — управление плеером</string>
    <string name="tile_on">Включено</string>
    <string name="tile_off">Выключено</string>
    <string name="cancel">Отмена</string>

    <string name="status_on_title">Работает</string>
    <string name="status_on_body">Удерживайте кнопку громкости в любом плеере, чтобы переключить трек.</string>
    <string name="status_off_title">Выключено</string>
    <string name="status_off_body">Включите службу KnobNext в разделе «Специальные возможности» → «Скачанные приложения».</string>
    <string name="enable_service">Включить</string>
    <string name="open_accessibility">Специальные возможности</string>

    <string name="restricted_title">Переключатель серый?</string>
    <string name="restricted_hint">Android блокирует службы у приложений, установленных из APK. Откройте «О приложении» → ⋮ → «Разрешить доступ к настройкам с ограниченным доступом», затем включите службу снова.</string>
    <string name="open_app_info">О приложении</string>

    <string name="setup_title">Настройка</string>
    <string name="setup_steps_left">Обязательных шагов осталось: %1$d</string>
    <string name="step_optional">по желанию</string>
    <string name="step_restricted_title">Снимите ограничение Android</string>
    <string name="step_restricted_body">KnobNext установлен из файла, поэтому Android пока не даёт включить службу. Откроется «О приложении»: нажмите ⋮ в правом верхнем углу → «Разрешить доступ к настройкам с ограниченным доступом» и вернитесь сюда.</string>
    <string name="step_restricted_button">Открыть «О приложении»</string>
    <string name="step_service_title">Включите службу KnobNext</string>
    <string name="step_service_body">Откроется страница KnobNext — включите переключатель и подтвердите. После этого приложение откроется само.</string>
    <string name="step_service_button">Включить</string>
    <string name="step_player_title">Подключите плеер</string>
    <string name="step_player_body">Название трека, перемотка и выбор плееров. Нужен доступ к уведомлениям — сами уведомления приложение не читает.</string>
    <string name="step_player_button">Подключить</string>

    <string name="access_title">Подключите плеер</string>
    <string name="access_body">Доступ к уведомлениям позволяет видеть, что играет, перематывать на 10 секунд и выбирать, в каких плеерах работают жесты. Сами уведомления приложение не читает.</string>
    <string name="access_button">Дать доступ</string>

    <string name="update_title">Доступно обновление</string>
    <string name="update_body">Версия %1$s</string>
    <string name="update_download">Скачать</string>

    <string name="now_playing_unknown">Без названия</string>

    <string name="gestures_title">Жесты</string>
    <string name="gestures_hint">Нажмите на жест, чтобы выбрать действие. При выключенном экране система уже успевает изменить громкость — после жеста KnobNext вернёт её обратно. На максимальной и нулевой громкости жест в эту сторону не сработает.</string>
    <string name="gesture_hold_up">Удерживать «+»</string>
    <string name="gesture_hold_down">Удерживать «−»</string>
    <string name="gesture_both">«+» и «−» вместе</string>
    <string name="gesture_double_up_off">Дважды «+» · экран выключен</string>
    <string name="gesture_double_down_off">Дважды «−» · экран выключен</string>
    <string name="gesture_tap">Короткое нажатие</string>
